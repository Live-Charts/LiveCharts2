<Project Sdk="Uno.Sdk/7.0.5">
  
  <PropertyGroup>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>

    <!--
    Uno Platform 7 renders every head with Skia, so a single net10.0 build serves
    desktop, browserwasm, android and ios apps; Uno no longer swaps an -android/-ios
    build for it, and a native-renderer build there would break those apps.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>

    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
      $(TargetFrameworks);
      net10.0-windows10.0.19041.0;
    </TargetFrameworks>

    <EnableMsixTooling Condition="$([MSBuild]::IsOSPlatform('windows'))">true</EnableMsixTooling>

    <!-- Ensures the .xr.xml files are generated in a proper layout folder -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>

    <RootNamespace>LiveChartsCore.SkiaSharpView.WinUI</RootNamespace>
    <AssemblyName>LiveChartsCore.SkiaSharpView.Uno.WinUI</AssemblyName>
    <PathToPackAssets>../../../</PathToPackAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- hack.. idk where is this being packed... -->
    <None Include="$(OutputPath)$(AssemblyName).uprimarker" Pack="false" />
  </ItemGroup>

  <Import Project="../../../nuget.props" />
  <PropertyGroup>
    <Description>
      $(Description) This package includes all the required code and dependencies for rendering charts in Uno Platform with SkiaSharp.
    </Description>
  </PropertyGroup>

  <Import Project="../../../build/WinUISharedLinks.Build.props" />
  <Import Project="../../../build/SharedLinks.Build.props" />
  <Import Project="../../../build/XamlSharedLinks.Build.props" />
  <Import Project="../../../build/NativeSharedLinks.Build.props" />

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);UNO_LVC;WINUI_LVC;XAML_LVC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LiveChartsCore.SkiaSharp/LiveChartsCore.SkiaSharpView.csproj" />
    <!--
    Uno Platform 7 ships SkiaSharp 4, where SKPaint.GetFont() is internal; SkiaSharp.HarfBuzz 3.x calls it
    from SKShaper.Shape(string, SKPaint), so text shaping throws when an app resolves 3.x. Require 4.x.
    -->
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.151.1" />
  </ItemGroup>

  <!--
  Skia references SKCanvasElement (Uno.WinUI.Graphics2DSK) and, on Windows, SkiaSharp.Views.WinUI,
  at the versions pinned by the Uno.Sdk.
  -->
  <PropertyGroup>
    <UnoFeatures>$(UnoFeatures);Skia</UnoFeatures>
    <!-- Uno 7 only adds SkiaSharp.Views.WinUI to the Windows build with this opt-in. -->
    <UnoEnableSkiaOnWinAppSdk>true</UnoEnableSkiaOnWinAppSdk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../generators/LiveChartsGenerators/LiveChartsGenerators.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  
</Project>
