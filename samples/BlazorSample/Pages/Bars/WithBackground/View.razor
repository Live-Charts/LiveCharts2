@page "/Bars/WithBackground"
@using LiveChartsCore.SkiaSharpView.Blazor
@using LiveChartsCore;
@using LiveChartsCore.SkiaSharpView;
@using LiveChartsCore.SkiaSharpView.Painting;
@using SkiaSharp;
@using ViewModelsSamples.Bars.WithBackground

<CartesianChart
    Series="@series"
    YAxes="@yAxes">
</CartesianChart>

@code {
    private static ViewModel viewModel = new();

    private ISeries[] series = new ISeries[]
    {
        new ColumnSeries<double>
        {
            Values = viewModel.Values1,
            Fill = new SolidColorPaint(new SKColor(180, 180, 180, 50)),
            IgnoresBarPosition = true,
            IsHoverable = false
        },
        new ColumnSeries<double>
        {
            Values = viewModel.Values2,
            IgnoresBarPosition = true
        }
    };

    private Axis[] yAxes = new Axis[]
    {
        new Axis
        {
            MinLimit = 0,
            MaxLimit = 10
        }
    };
}
