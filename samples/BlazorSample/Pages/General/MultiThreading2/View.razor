@page "/General/MultiThreading2"
@using LiveChartsCore.SkiaSharpView.Blazor
@using LiveChartsCore;
@using LiveChartsCore.SkiaSharpView;
@using ViewModelsSamples.General.MultiThreading2

<CartesianChart
    Series="@series">
</CartesianChart>

@code {
    private ISeries[] series;

    protected override void OnInitialized()
    {
        // the view model adds points from 10 background tasks,
        // it uses the passed delegate to change the values on the UI thread.
        var viewModel = new ViewModel(action => _ = InvokeAsync(action));

        series = new ISeries[]
        {
            new LineSeries<int>
            {
                Values = viewModel.Values,
                GeometryFill = null,
                GeometryStroke = null,
                LineSmoothness = 0
            }
        };
    }
}
