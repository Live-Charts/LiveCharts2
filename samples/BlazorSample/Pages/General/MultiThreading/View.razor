@page "/General/MultiThreading"
@using LiveChartsCore.SkiaSharpView.Blazor
@using LiveChartsCore;
@using LiveChartsCore.SkiaSharpView;
@using ViewModelsSamples.General.MultiThreading

@* the chart locks the view model's Sync object while it reads the values *@
<CartesianChart
    @ref="_chart"
    Series="@series"
    SyncContext="_viewModel.Sync">
</CartesianChart>

@code {
    private CartesianChart _chart;

    // the view model adds points from 10 background tasks,
    // it locks the Sync object every time it changes the values.
    private readonly ViewModel _viewModel = new();
    private ISeries[] series;

    protected override void OnInitialized()
    {
        series = new ISeries[]
        {
            new LineSeries<int>
            {
                Values = _viewModel.Values,
                GeometryFill = null,
                GeometryStroke = null,
                LineSmoothness = 0
            }
        };
    }
}
