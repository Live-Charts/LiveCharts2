@page "/Pies/OutLabels"
@using LiveChartsCore
@using LiveChartsCore.Kernel
@using LiveChartsCore.Measure
@using LiveChartsCore.SkiaSharpView
@using LiveChartsCore.SkiaSharpView.Blazor

<PieChart
	Series="Series"
    IsClockwise="false"
    InitialRotation="-90">
</PieChart>

@code {
    private ISeries[] Series { get; set; }

    protected override void OnInitialized()
    {
        static string LabelFormatter(ChartPoint point) =>
            $"This slide takes {point.Coordinate.PrimaryValue} " +
            $"out of {point.StackedValue!.Total} parts";

        static string TooltipFormatter(ChartPoint point) =>
            $"{point.StackedValue!.Share:P2}";

        Series = new ISeries[]
        {
            new PieSeries<double>
            {
                Name = "Maria",
                Values = new double[] { 8 },
                ShowDataLabels = true,
                DataLabelsPosition = PolarLabelsPosition.Outer,
                DataLabelsSize = 15,
                DataLabelsFormatter = LabelFormatter,
                ToolTipLabelFormatter = TooltipFormatter
            },
            new PieSeries<double>
            {
                Name = "Susan",
                Values = new double[] { 6 },
                ShowDataLabels = true,
                DataLabelsPosition = PolarLabelsPosition.Outer,
                DataLabelsSize = 15,
                DataLabelsFormatter = LabelFormatter,
                ToolTipLabelFormatter = TooltipFormatter
            },
            new PieSeries<double>
            {
                Name = "Charles",
                Values = new double[] { 5 },
                ShowDataLabels = true,
                DataLabelsPosition = PolarLabelsPosition.Outer,
                DataLabelsSize = 15,
                DataLabelsFormatter = LabelFormatter,
                ToolTipLabelFormatter = TooltipFormatter
            },
            new PieSeries<double>
            {
                Name = "Fiona",
                Values = new double[] { 3 },
                ShowDataLabels = true,
                DataLabelsPosition = PolarLabelsPosition.Outer,
                DataLabelsSize = 15,
                DataLabelsFormatter = LabelFormatter,
                ToolTipLabelFormatter = TooltipFormatter
            },
            new PieSeries<double>
            {
                Name = "George",
                Values = new double[] { 3 },
                ShowDataLabels = true,
                DataLabelsPosition = PolarLabelsPosition.Outer,
                DataLabelsSize = 15,
                DataLabelsFormatter = LabelFormatter,
                ToolTipLabelFormatter = TooltipFormatter
            }
        };
    }
}
