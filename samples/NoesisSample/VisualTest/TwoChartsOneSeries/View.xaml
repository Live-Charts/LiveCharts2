<UserControl x:Class="NoesisSample.VisualTest.TwoChartsOneSeries.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
             xmlns:vms="clr-namespace:ViewModelsSamples.VisualTest.TwoChartsOneSeries;assembly=NoesisSample">
    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <lvc:CartesianChart
            Grid.Row="0"
            Series="{Binding Series}"
            ZoomMode="X">
        </lvc:CartesianChart>

        <lvc:CartesianChart
            Grid.Row="1"
            Series="{Binding Series}"
            ZoomMode="X">
        </lvc:CartesianChart>
    </Grid>
</UserControl>
