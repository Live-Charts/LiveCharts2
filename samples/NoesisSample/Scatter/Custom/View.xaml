<UserControl
    x:Class="NoesisSample.Scatter.Custom.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
    xmlns:vms="clr-namespace:ViewModelsSamples.Scatter.Custom;assembly=NoesisSample"
    xmlns:svg="clr-namespace:LiveChartsCore.Drawing;assembly=LiveChartsCore"
    xmlns:draw="clr-namespace:LiveChartsCore.Noesis.Drawing.Geometries;assembly=LiveChartsCore.Noesis"
    xmlns:d="clr-namespace:LiveChartsCore.Defaults;assembly=LiveChartsCore"
    xmlns:local="clr-namespace:NoesisSample.Scatter.Custom">

    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>

    <lvc:CartesianChart>
        <lvc:CartesianChart.Series>
            <lvc:SeriesCollection>

                <local:HeartScatterSeries
                    Values="{Binding Values1}"
                    Stroke="{x:Null}"
                    GeometrySize="40" />

                <local:SvgScatterSeries
                    Values="{Binding Values2}"
                    GeometrySvg="{Binding PinPath}"
                    GeometrySize="40"/>

                <local:MyGeometryScatterSeries
                    Values="{Binding Values3}"
                    GeometrySize="40"/>
            </lvc:SeriesCollection>
        </lvc:CartesianChart.Series>
    </lvc:CartesianChart>
</UserControl>
