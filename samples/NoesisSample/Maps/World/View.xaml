<UserControl x:Class="NoesisSample.Maps.World.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
             xmlns:vms="clr-namespace:ViewModelsSamples.Maps.World;assembly=NoesisSample">
    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>
    <lvc:GeoMap
        x:Name="geoMap"
        Series="{Binding Series}"
        MapProjection="Mercator">
    </lvc:GeoMap>
</UserControl>
