<UserControl x:Class="NoesisSample.Maps.RotatingOrthographic.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
             xmlns:vms="clr-namespace:ViewModelsSamples.Maps.RotatingOrthographic;assembly=NoesisSample">
    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>
    <lvc:GeoMap x:Name="geoMap"
                Series="{Binding Series}"
                MapProjection="Orthographic"/>
</UserControl>
