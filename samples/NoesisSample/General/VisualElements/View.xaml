    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
    xmlns:vms="clr-namespace:ViewModelsSamples.General.VisualElements;assembly=NoesisSample">

    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>

    <lvc:CartesianChart
        VisualElements="{Binding VisualElements}">
    </lvc:CartesianChart>
</UserControl>
