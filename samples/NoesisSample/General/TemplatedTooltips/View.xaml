<UserControl
    x:Class="NoesisSample.General.TemplatedTooltips.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
    xmlns:vms="clr-namespace:ViewModelsSamples.General.TemplatedTooltips;assembly=NoesisSample"
    xmlns:ctx="clr-namespace:LiveChartsCore.Kernel;assembly=LiveChartsCore"
    xmlns:local="clr-namespace:NoesisSample.General.TemplatedTooltips">

    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>

    <lvc:CartesianChart>

        <lvc:CartesianChart.Tooltip>
            <vms:CustomTooltip/>
        </lvc:CartesianChart.Tooltip>

        <lvc:CartesianChart.Series>
            <lvc:SeriesCollection>
                <local:CustomGeometryPointColumnSeries
                    Values="{Binding Values}"/>
            </lvc:SeriesCollection>
        </lvc:CartesianChart.Series>

    </lvc:CartesianChart>

</UserControl>
