<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <LangVersion>preview</LangVersion>
        <IsPackable>false</IsPackable>
        <UseRidGraph>true</UseRidGraph>
        <RootNamespace></RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Noesis.App.Displays.Win32" Version="4.0.0" />
        <PackageReference Include="Noesis.App.RenderContexts.D3D11" Version="4.0.0" />
        <ProjectReference Include="../../src/noesis/LiveChartsCore.Noesis/LiveChartsCore.Noesis.csproj" />
        <ProjectReference Include="../../generators/LiveChartsGenerators/LiveChartsGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <EmbeddedResource Include="**/*.xaml" />
        <EmbeddedResource Include="../WPFSample/Images/livecharts.png" LogicalName="Images.livecharts.png" />
        <EmbeddedResource Include="../ViewModelsSamples/Maps/CustomMap/mexico-states.geojson" LogicalName="ViewModelsSamples.Maps.CustomMap.mexico-states.geojson" />
    </ItemGroup>
</Project>
