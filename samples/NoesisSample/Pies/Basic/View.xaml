<UserControl x:Class="NoesisSample.Pies.Basic.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.Noesis;assembly=LiveChartsCore.Noesis"
             xmlns:vms="clr-namespace:ViewModelsSamples.Pies.Basic;assembly=NoesisSample">

    <UserControl.DataContext>
        <vms:ViewModel/>
    </UserControl.DataContext>

    <lvc:PieChart SeriesSource="{Binding Data}">
        <lvc:PieChart.SeriesTemplate>
            <DataTemplate>
                <lvc:XamlPieSeries
                    SeriesName="{Binding Name}"
                    Values="{Binding Values}"/>
            </DataTemplate>
        </lvc:PieChart.SeriesTemplate>
        <lvc:PieChart.Title>
            <lvc:XamlDrawnLabelVisual
                Text="My chart title"
                TextSize="25"
                Padding="{lvc:Padding Value='15'}"/>
        </lvc:PieChart.Title>
    </lvc:PieChart>

</UserControl>
